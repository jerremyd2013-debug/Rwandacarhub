rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }
    
    // Vehicles Collection (Public Marketplace listings)
    // Any visitor can read available vehicles; anyone can post/update their vehicle listings
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow create: if isValidId(vehicleId)
                    && request.resource.data.make is string
                    && request.resource.data.model is string
                    && request.resource.data.priceRwf is number;
      allow update: if isValidId(vehicleId);
      allow delete: if isValidId(vehicleId);
    }

    // Accounts Collection
    match /accounts/{accountId} {
      allow read: if true;
      allow create: if isValidId(accountId)
                    && request.resource.data.name is string
                    && request.resource.data.email is string;
      allow update: if isValidId(accountId);
      allow delete: if isValidId(accountId);
    }

    // Bookings Collection (Test drives & vehicle inspections)
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if isValidId(bookingId)
                    && request.resource.data.customerName is string
                    && request.resource.data.customerPhone is string;
      allow update: if isValidId(bookingId);
      allow delete: if isValidId(bookingId);
    }

    // Messages Collection (Buyer inquiries & responses)
    match /messages/{messageId} {
      allow read: if true;
      allow create: if isValidId(messageId)
                    && request.resource.data.senderName is string
                    && request.resource.data.message is string;
      allow update: if isValidId(messageId);
      allow delete: if isValidId(messageId);
    }

    // Partner Advertisements Collection
    match /partnerAds/{adId} {
      allow read: if true;
      allow create, update, delete: if isValidId(adId);
    }

    // Admin Activity & Audit Logs Collection
    match /activityLogs/{logId} {
      allow read: if true;
      allow create, update, delete: if isValidId(logId);
    }

    // Default safety fallback: deny anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
